# Copy to .env and fill in.
PORT=4000
DATA_DIR=./data

# Weather (Open-Meteo, no key needed). Decimal degrees.
WALL_LAT=
WALL_LON=
WALL_LOCATION_NAME=
WALL_UNITS=fahrenheit

# School lunch menus: the Thrillshare menus API the school's dining page loads from
# (api/v2/s/<section>/menus?query_id=<the page's filter id>). Can also be set in Settings.
SCHOOL_LUNCH_URL=
